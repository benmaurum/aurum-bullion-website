# One public HTTPS address.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.aurumbullion\.co\.uk$ [NC]
RewriteRule ^ https://www.aurumbullion.co.uk/%{REQUEST_URI} [R=301,L]

# Deployment archives are not website downloads.
<FilesMatch "^(aurum-upload-[0-9]+\.zip|aurum-fixes.*\.zip|.*\.(log|ini|bak))$">
  Require all denied
</FilesMatch>

# Revalidate deployable content so returning visitors receive current fixes.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
