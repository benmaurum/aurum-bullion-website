Options -Indexes
RewriteEngine On
# Known legacy content. Rules precede hostname canonicalisation to avoid extra hops.
RewriteRule ^home/?$ https://www.aurumbullion.co.uk/ [R=301,L,NE,QSD]
RewriteRule ^about\-us/?$ https://www.aurumbullion.co.uk/index.html#about [R=301,L,NE,QSD]
RewriteRule ^contact\-us/?$ https://www.aurumbullion.co.uk/index.html#contact [R=301,L,NE,QSD]
RewriteRule ^contact\-us\-3/?$ https://www.aurumbullion.co.uk/index.html#contact [R=301,L,NE,QSD]
RewriteRule ^numismatic\-coinage/?$ https://www.aurumbullion.co.uk/british-gold-coins.html [R=301,L,NE,QSD]
RewriteRule ^market\-watch/?$ https://www.aurumbullion.co.uk/insights.html [R=301,L,NE,QSD]
RewriteRule ^newsroom/?$ https://www.aurumbullion.co.uk/insights.html [R=301,L,NE,QSD]
RewriteRule ^privacy\-policy/?$ https://www.aurumbullion.co.uk/privacy.html [R=301,L,NE,QSD]
RewriteRule ^terms\-conditions/?$ https://www.aurumbullion.co.uk/terms.html [R=301,L,NE,QSD]
RewriteRule ^vat\-cgt/?$ https://www.aurumbullion.co.uk/index.html#tax [R=301,L,NE,QSD]
RewriteRule ^conflict\-free\-policy/?$ https://www.aurumbullion.co.uk/conflict-free.html [R=301,L,NE,QSD]
RewriteRule ^cookie/?$ https://www.aurumbullion.co.uk/cookies.html [R=301,L,NE,QSD]
RewriteRule ^cookie\-policy\-uk/?$ https://www.aurumbullion.co.uk/cookies.html [R=301,L,NE,QSD]
RewriteRule ^payment\-options/?$ https://www.aurumbullion.co.uk/payment-options.html [R=301,L,NE,QSD]
RewriteRule ^wp\-content/uploads/2025/04/Labi\-FreeE\-Guide\.pdf/?$ https://www.aurumbullion.co.uk/brochure.html [R=301,L,NE,QSD]
# Old pagination and filter combinations are consolidated into the current collection.
RewriteRule ^shop(?:/page/[1-9][0-9]*)?/?$ https://www.aurumbullion.co.uk/catalogue.html [R=301,L,QSD]
RewriteRule ^product-category/(?:bullion-coins|proof-coins-sets|graded-coins|collectable-coins|new-products|special-offers)(?:/page/[1-9][0-9]*)?/?$ https://www.aurumbullion.co.uk/catalogue.html [R=301,L,QSD]
# Product redirects retain the individual coin identity.
